#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {

    macros {
        lng1_macro: lng1_macro {
            compatible = "zmk,behavior-macro";
            label = "LNG1_MACRO";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT &kp LCTRL>,
                       <&macro_tap &kp SPACE>,
                       <&macro_release &kp LALT &kp LCTRL>;
        };
    };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  ESC |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | CAPS |
// | GRV  |  A  |S/SFT|D/CTL|F/GUI|  G  |   |  H  |J/GUI|K/CTL|L/SFT|  ;  |  '   |
// | ALT  |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | LNG1 |
//                    | BSPC| FN1 | TAB |   | ENT | FN2 | SPC |
                        display-name = "Base";
                        bindings = <
   &kp ESC         &kp Q &kp W       &kp E       &kp R        &kp T           &kp Y &kp U        &kp I       &kp O   &kp P    &kp CAPS
   &kp GRAVE       &kp A &mt LSHFT S &mt LCTRL D &mt LGUI F   &kp G           &kp H &mt RGUI J   &mt RCTRL K &mt RSHFT L &kp SEMI &kp SQT
   &kp LALT        &kp Z &kp X       &kp C       &kp V        &kp B           &kp N &kp M        &kp COMMA   &kp DOT &kp FSLH &lng1_macro
                                      &kp BSPC    &mo 1        &kp TAB         &kp RET &mo 2      &kp SPACE
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// | NO   |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |  -   |
// | NO   | NO  | NO  | NO  | NO  | NO  |   | LFT | DWN | UP  | RGT | NO  |  =   |
// | NO   | NO  | (   | [   | {   | NO  |   | NO  |  }  |  ]  |  )  | NO  |  \   |
//                    | TRNS| TRNS| TRNS|   | TRNS| FN3 | TRNS|
                        display-name = "Lower";
                        bindings = <
   &none  &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR &kp MINUS
   &none  &none    &none    &none    &none    &none       &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &none    &kp EQUAL
   &none  &none    &kp LPAR &kp LBKT &kp LBRC &none       &none     &kp RBRC  &kp RBKT  &kp RPAR  &none    &kp BSLH
                            &trans   &trans   &trans      &trans    &mo 3     &trans
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// | NO   | NO   |  7  |  8  |  9  | NO   |   | NO  | BRID| NO  | BRIU| NO  | NO   |
// | NO   | NO   |  4  |  5  |  6  |  0   |   | NO  | VOLD|MPLY | VOLU| NO  | NO   |
// | NO   | NO   |  1  |  2  |  3  | DOT  |   | NO  | MPRV|MUTE | MNXT| NO  | NO   |
//                    | TRNS| FN3 | TRNS |   | TRNS| TRNS| TRNS|
                        display-name = "Raise";
                        bindings = <
   &none &none &kp N7 &kp N8 &kp N9 &none       &none        &kp C_BRI_DN &none        &kp C_BRI_UP &none &none
   &none &none &kp N4 &kp N5 &kp N6 &kp N0      &none        &kp C_VOL_DN &kp C_PLAY   &kp C_VOL_UP &none &none
   &none &none &kp N1 &kp N2 &kp N3 &kp DOT     &none        &kp C_PREV   &kp C_MUTE   &kp C_NEXT   &none &none
                      &trans &mo 3  &trans      &trans       &trans       &trans
                        >;
                };

                function_layer {
// -----------------------------------------------------------------------------------------
// |  F1  |  F2  |  F3  |  F4  |  F5  |  F6  |   |  F7  |  F8  |  F9  |  F10 |  F11 |  F12 |
// | NO   | NO   | NO   | NO   | NO   | NO   |   | TOG5 | NO   | NO   | NO   | NO   | NO   |
// | NO   | NO   | NO   | NO   | NO   | NO   |   | NO   | NO   | NO   | NO   | NO   | NO   |
//                       | TRNS | TRNS | TRNS |   | TRNS | TRNS | TRNS |
                        display-name = "Function";
                        bindings = <
   &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6   &kp F7 &kp F8 &kp F9  &kp F10 &kp F11 &kp F12
   &none  &none  &none  &none  &none  &none    &tog 4 &none  &none   &none   &none   &none
   &none  &none  &none  &none  &none  &none    &none  &none  &none   &none   &none   &none
                        &trans &trans &trans   &trans &trans &trans
                        >;
                };

                extra_1 {
                        status = "reserved";
                };

                extra_2 {
                        status = "reserved";
                };

                extra_3 {
                        status = "reserved";
                };
        };
};
